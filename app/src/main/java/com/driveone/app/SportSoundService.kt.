package com.driveone.app

import android.Manifest
import android.app.Notification
import android.app.NotificationChannel
import android.app.NotificationManager
import android.app.PendingIntent
import android.app.Service
import android.content.Intent
import android.content.pm.PackageManager
import android.content.pm.ServiceInfo
import android.location.Location
import android.location.LocationListener
import android.location.LocationManager
import android.media.AudioAttributes
import android.media.AudioFormat
import android.media.AudioManager
import android.media.AudioTrack
import android.os.Build
import android.os.IBinder
import android.os.Process
import android.os.SystemClock
import java.util.concurrent.atomic.AtomicBoolean
import kotlin.math.max
import kotlin.math.min

/** Continuous synthetic audio, kept alive by a foreground media-playback service.
 * A notification includes a stop action in case the car disconnects.
 */
class SportSoundService : Service(), LocationListener {
    companion object {
        const val ACTION_START = "com.driveone.app.SOUND_START"
        const val ACTION_STOP = "com.driveone.app.SOUND_STOP"
        const val ACTION_TEST = "com.driveone.app.SOUND_TEST"
        private const val CHANNEL_ID = "driveone_sport_sound"
        private const val NOTIFICATION_ID = 1203
    }

    @Volatile private var speed = 0f
    @Volatile private var acceleration = 0f
    @Volatile private var previousTimestamp = 0L
    @Volatile private var demoStartedAt = 0L
    @Volatile private var demoEndAt = 0L
    private val running = AtomicBoolean(false)
    private var soundThread: Thread? = null
    private var locationManager: LocationManager? = null
    private var gpsRegistered = false
    private val preferences by lazy { getSharedPreferences("drive_one_v3", MODE_PRIVATE) }

    override fun onBind(intent: Intent?): IBinder? = null

    override fun onCreate() {
        super.onCreate()
        val mgr = getSystemService(NOTIFICATION_SERVICE) as NotificationManager
        mgr.createNotificationChannel(NotificationChannel(
            CHANNEL_ID, "DRIVE ONE Sport Sound", NotificationManager.IMPORTANCE_LOW
        ))
    }

    override fun onStartCommand(intent: Intent?, flags: Int, startId: Int): Int {
        if (intent?.action == ACTION_STOP) {
            preferences.edit().putBoolean("engine_enabled", false).apply()
            stopSelf()
            return START_NOT_STICKY
        }
        if (intent?.action == ACTION_TEST) {
            demoStartedAt = SystemClock.elapsedRealtime()
            demoEndAt = demoStartedAt + 4000L
        }
        val manager = getSystemService(LOCATION_SERVICE) as LocationManager
        val hasLocation = checkSelfPermission(Manifest.permission.ACCESS_FINE_LOCATION) == PackageManager.PERMISSION_GRANTED &&
            manager.isProviderEnabled(LocationManager.GPS_PROVIDER)
        val type = ServiceInfo.FOREGROUND_SERVICE_TYPE_MEDIA_PLAYBACK or
            (if (hasLocation) ServiceInfo.FOREGROUND_SERVICE_TYPE_LOCATION else 0)
        try {
            if (Build.VERSION.SDK_INT >= 29) startForeground(NOTIFICATION_ID, notification(), type)
            else startForeground(NOTIFICATION_ID, notification())
        } catch (error: RuntimeException) {
            // Failure is surfaced by Android; never claim that sound is running.
            stopSelf()
            return START_NOT_STICKY
        }
        if (hasLocation && !gpsRegistered) {
            try {
                manager.requestLocationUpdates(LocationManager.GPS_PROVIDER, 1000L, 0f, this)
                gpsRegistered = true
                locationManager = manager
            } catch (_: SecurityException) { gpsRegistered = false }
        }
        if (running.compareAndSet(false, true)) {
            soundThread = Thread(::playLoop, "DRIVE_ONE_SportSound").also { it.start() }
        }
        return START_NOT_STICKY
    }

    private fun notification(): Notification {
        val stopIntent = Intent(this, SportSoundService::class.java).setAction(ACTION_STOP)
        val pending = PendingIntent.getService(
            this, 1, stopIntent, PendingIntent.FLAG_UPDATE_CURRENT or PendingIntent.FLAG_IMMUTABLE
        )
        return Notification.Builder(this, CHANNEL_ID)
            .setSmallIcon(android.R.drawable.ic_media_play)
            .setContentTitle("DRIVE ONE · Sport Sound")
            .setContentText("Moteur synthétique actif · Arrêter depuis cette notification")
            .setOngoing(true)
            .addAction(android.R.drawable.ic_media_pause, "Arrêter", pending)
            .build()
    }

    override fun onLocationChanged(location: Location) {
        if (!location.hasSpeed()) {
            speed = 0f
            acceleration = 0f
            return
        }
        val now = SystemClock.elapsedRealtime()
        val previous = speed
        val dt = (now - previousTimestamp) / 1000f
        val newSpeed = (location.speed * 3.6f).coerceIn(0f, 240f)
        acceleration = if (previousTimestamp > 0 && dt in 0.4f..6f)
            (((newSpeed - previous) / 3.6f) / dt).coerceIn(-5f, 5f) else 0f
        speed = newSpeed
        previousTimestamp = now
    }

    private fun playLoop() {
        Process.setThreadPriority(Process.THREAD_PRIORITY_AUDIO)
        val rate = 22050
        val pcm = ShortArray(1024)
        val minBytes = AudioTrack.getMinBufferSize(rate, AudioFormat.CHANNEL_OUT_MONO, AudioFormat.ENCODING_PCM_16BIT)
        if (minBytes <= 0) { stopSelf(); return }
        var track: AudioTrack? = null
        try {
            track = AudioTrack.Builder()
                .setAudioAttributes(AudioAttributes.Builder()
                    .setUsage(AudioAttributes.USAGE_MEDIA)
                    .setContentType(AudioAttributes.CONTENT_TYPE_MUSIC).build())
                .setAudioFormat(AudioFormat.Builder()
                    .setEncoding(AudioFormat.ENCODING_PCM_16BIT)
                    .setSampleRate(rate)
                    .setChannelMask(AudioFormat.CHANNEL_OUT_MONO).build())
                .setTransferMode(AudioTrack.MODE_STREAM)
                .setBufferSizeInBytes(max(minBytes, pcm.size * 6))
                .build()
            if (track.state != AudioTrack.STATE_INITIALIZED) { stopSelf(); return }
            track.play()
            val synth = EngineSynth(rate)
            while (running.get()) {
                val now = SystemClock.elapsedRealtime()
                val testActive = now < demoEndAt
                val enabled = preferences.getBoolean("engine_enabled", true)
                if (!enabled && !testActive) break
                val testElapsed = (now - demoStartedAt).coerceAtLeast(0L)
                // In TEST mode pitch rises, then falls, so audio can be checked at 0 km/h.
                val testKmh = when {
                    testElapsed < 1800L -> testElapsed * 120f / 1800f
                    testElapsed < 3600L -> (3600L - testElapsed) * 120f / 1800f
                    else -> 0f
                }
                val requested = if (testActive) testKmh else speed
                val requestedAccel = if (testActive) {
                    if (testElapsed < 1800L) 2.4f else -2.4f
                } else acceleration
                synth.render(pcm, requested, requestedAccel)
                val written = track.write(pcm, 0, pcm.size, AudioTrack.WRITE_BLOCKING)
                if (written < 0) break
            }
        } catch (_: Exception) {
            // Audio device errors stop the service rather than endlessly retrying.
        } finally {
            try { track?.pause(); track?.flush(); track?.release() } catch (_: Exception) { }
            running.set(false)
            stopSelf()
        }
    }

    override fun onDestroy() {
        running.set(false)
        if (gpsRegistered) try { locationManager?.removeUpdates(this) } catch (_: Exception) { }
        gpsRegistered = false
        soundThread?.interrupt()
        super.onDestroy()
    }
} 
 